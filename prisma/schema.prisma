datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  email     String    @unique
  
  // projetos Projeto[] // TODO: Criar modelo de projetos futuramente
  
  deletedAt DateTime? 
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}