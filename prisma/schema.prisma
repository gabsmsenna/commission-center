datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  email     String    @unique
  projects Project[]
  
  deletedAt DateTime? 
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Project {
  id                   Int      @id @default(autoincrement())
  userId               Int      @map("user_id")
  name                 String   @db.VarChar(255)
  commissionPercentage Decimal  @map("commission_percentage") @db.Decimal(5, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id])
  revenues ProjectRevenue[]

  @@map("projects")
}

model ProjectRevenue {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  description  String   @db.VarChar(255)
  profitAmount Decimal  @map("profit_amount") @db.Decimal(10, 2)
  revenueDate  DateTime @map("revenue_date")
  createdAt    DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("project_revenues")
}